:0.25,"gradient_norm_log_beta":5.41484095143654e-18,"mean_probe_score":1.875,"objective_gradient_norm_log_beta":8.563934561606234e-19,"probe_term":0.0625,"rescale_factors":[0.5,1.0,2.0],"rescale_scores":[1.875,1.875,1.875],"rescale_spread":0.0},"displacement":{"maximum_absolute":4.482655033810616,"radius":3.6662870108369305,"shape":0.1464100805813496,"total":3.6692092278210895},"epochs":40,"history_first":{"epoch":0,"known":7.72603813185871,"probe":0.06246185302734375,"total":7.788499984886053},"history_last":{"epoch":39,"known":0.0,"probe":0.06219482421875,"total":0.06219482421875},"measurements":{"coverage_offset_mean":-0.2778911025855607,"held_out_family_rejection":0.0,"known_false_rejection":{"per_domain":{"0":{"rejection_recall":0.03298611111111111,"row_count":576},"1":{"rejection_recall":0.07366071428571429,"row_count":448},"2":{"rejection_recall":0.19270833333333334,"row_count":384},"3":{"rejection_recall":0.0,"row_count":2496},"4":{"rejection_recall":0.15625,"row_count":192},"5":{"rejection_recall":null,"row_count":0}},"rejection_recall":0.0380859375,"row_count":4096},"known_novel_acceptance":0.913818359375,"rejection":{"per_domain":{"0":{"rejection_recall":0.1499460625674218,"row_count":1854},"1":{"rejection_recall":0.18585298196948682,"row_count":1442},"2":{"rejection_recall":0.48462783171521034,"row_count":1236},"3":{"rejection_recall":0.00012447099825740602,"row_count":8034},"4":{"rejection_recall":0.7783171521035599,"row_count":618},"5":{"rejection_recall":null,"row_count":0}},"rejection_recall":0.12340716019417476,"row_count":13184}},"placement":"relative"}},"centroid_unit":20.40899109823831,"openset_row_count":13184,"placement_unit":2.8694563467983283,"probe_count":52736,"report_row_count":4096,"seed":37,"unit_ratio":0.14059765781592298}],"probes":{"held_out_families":["masking","random_direction"],"multiplier_rationale":"N83.6. Multiples of the global radius unit, straddling the fitted boundary so the hinge is active on both sides of it.","multipliers":[1.0,1.5,2.0,3.0],"seed_offset":83300,"train_families":["axis_tangent","normal"]},"program":"v13","registration_notes":["N83.1 - a boundary that moves is satisfiable by noise. The shuffled-owner null shares the geometry, probe count, distances, optimiser, step budget and split, and movement alone is necessary but not sufficient: the trained boundary must also improve real out-of-set recall at matched coverage over its own initialisation. The v12-form arm is retained as the instrument's negative end. If it does not fail the degeneracy test while the absolute arm passes, M83 is void.","N83.2 - the out-of-set rows are domain-stratified to the corpus and per-domain recall is reported beside every aggregate. Sketch is 0 of 13865 rows because the corpus itself holds only 158 sketch rows; no sketch claim is available.","N83.3 - known-class coverage is matched at 90 percent before any recall figure is read, and the known-class novel-image control must be accepted at that operating point.","N83.4 - Phase A is a closed-form SVD fit and is exactly converged, which is stronger than the registered iterative fit. Recorded so the deviation is visible.","N83.5 - the degeneracy contract is read on the mean probe score, not on the hinged objective. A probe already outside its boundary contributes zero gradient, so a saturated healthy objective and a scale-blind one are indistinguishable under the hinge. The hinged gradient and the active fraction are reported as context, never as verdict.","N83.6 - probes are placed at multiples of one global radius shared by every class rather than at multiples of the inter-centroid distance. Boundaries sit at roughly four percent of the centroid distance, so a ladder measured in that unit lands entirely outside the band where supervision does work. The unit is a single scalar over frozen geometry and cannot carry any individual class's extent, which is the property that blocks the v12 cancellation.","N83.7 - the known-class evaluation rows are selected by domain quota rather than by position, which is a deliberate deviation from the M80 and M81 partition. The corpus is class-major and every class stores its 350 quickdraw rows first, so taking rows 512 to 576 of each class yields a held-out set containing zero quickdraw against an out-of-set that is 61 percent quickdraw. Under that split the rejection comparison measures domain, not novelty, and N83.2's guarantee was void on the known side even though it held on the unseen side. The quota split matches the two profiles to a deviation of 0.0 and, as a side effect, makes the fit set domain-representative as well: quickdraw falls from 68.4 percent of the fit rows to 60.7 percent against a corpus share of 60.8 percent. This was found from a smoke run and changed before any evidence was sealed; it is a defect in the measurement setup, not a result that was disliked.","N83.7a - the same positional split underlies M80 and M81, whose held-out accuracy figures were therefore read on evaluation rows containing no quickdraw at all while their dictionaries were fitted on rows that were 68 percent quickdraw. Those milestones' evidence is sealed and is not retouched. The figures stand as measured; what they measure is narrower than their prose implies, and any later claim resting on them must say so."],"schema_version":1,"sealed":true,"seeds":[11,23,37],"training":{"batch_size":512,"epochs":40,"learning_rate":0.02,"margin":0.25,"optimizer":"adam","optimizer_caution":"Adam divides by the running root mean square of the gradient, so a dead term still produces movement from pure numerical noise. Displacement is therefore never read as evidence on its own; see N83.1.","probe_weight":1.0}}
