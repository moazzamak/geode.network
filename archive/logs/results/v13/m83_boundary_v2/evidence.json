w_count":192},"5":{"rejection_recall":null,"row_count":0}},"rejection_recall":0.038330078125,"row_count":4096},"known_novel_acceptance":0.91357421875,"rejection":{"per_domain":{"0":{"rejection_recall":0.14617044228694714,"row_count":1854},"1":{"rejection_recall":0.18654646324549237,"row_count":1442},"2":{"rejection_recall":0.48381877022653724,"row_count":1236},"3":{"rejection_recall":0.00012447099825740602,"row_count":8034},"4":{"rejection_recall":0.7734627831715211,"row_count":618},"5":{"rejection_recall":null,"row_count":0}},"rejection_recall":0.12264866504854369,"row_count":13184}},"placement":"absolute"},"v12_relative":{"degeneracy_at_final":{"active_fraction":0.25,"gradient_norm_log_beta":5.547471685779702e-18,"mean_probe_score":1.875,"objective_gradient_norm_log_beta":8.429301476245692e-19,"probe_term":0.0625,"rescale_factors":[0.5,1.0,2.0],"rescale_scores":[1.875,1.875,1.875],"rescale_spread":0.0},"degeneracy_at_initialisation":{"active_fraction":0.25,"gradient_norm_log_beta":5.41484095143654e-18,"mean_probe_score":1.875,"objective_gradient_norm_log_beta":8.563934561606234e-19,"probe_term":0.0625,"rescale_factors":[0.5,1.0,2.0],"rescale_scores":[1.875,1.875,1.875],"rescale_spread":0.0},"displacement":{"maximum_absolute":4.482655033810616,"radius":3.6662870108369305,"shape":0.1464100805813496,"total":3.6692092278210895},"epochs":40,"history_first":{"epoch":0,"known":7.72603813185871,"probe":0.06246185302734375,"total":7.788499984886053},"history_last":{"epoch":39,"known":0.0,"probe":0.06219482421875,"total":0.06219482421875},"measurements":{"coverage_offset_mean":-0.2778911025855607,"held_out_family_rejection":0.42578125,"known_false_rejection":{"per_domain":{"0":{"rejection_recall":0.03298611111111111,"row_count":576},"1":{"rejection_recall":0.07366071428571429,"row_count":448},"2":{"rejection_recall":0.19270833333333334,"row_count":384},"3":{"rejection_recall":0.0,"row_count":2496},"4":{"rejection_recall":0.15625,"row_count":192},"5":{"rejection_recall":null,"row_count":0}},"rejection_recall":0.0380859375,"row_count":4096},"known_novel_acceptance":0.913818359375,"rejection":{"per_domain":{"0":{"rejection_recall":0.1499460625674218,"row_count":1854},"1":{"rejection_recall":0.18585298196948682,"row_count":1442},"2":{"rejection_recall":0.48462783171521034,"row_count":1236},"3":{"rejection_recall":0.00012447099825740602,"row_count":8034},"4":{"rejection_recall":0.7783171521035599,"row_count":618},"5":{"rejection_recall":null,"row_count":0}},"rejection_recall":0.12340716019417476,"row_count":13184}},"placement":"relative"}},"centroid_unit":20.40899109823831,"openset_row_count":13184,"placement_unit":30.164603479240636,"placement_unit_rule":"data_extent","probe_count":52736,"probe_validity":{"fraction_beyond_known_median":0.8519986347087378,"known_distance_median":30.164603479240636,"known_distance_tenth_percentile":24.3732832595415,"probe_distance_maximum":90.49381043772212,"probe_distance_median":52.788056088671084,"reaches_past_known_cloud":true},"report_row_count":4096,"seed":37,"unit_ratio":1.4780056169383318}],"probes":{"held_out_families":["masking","random_direction"],"multiplier_rationale":"N83.8. Multiples of the data extent unit. At 1.0 a probe sits at the median distance of a row from its own centroid, so the ladder straddles the edge of the known cloud and the upper rungs are clearly outside it. Under N83.6's unit the same multipliers put every probe between 2.87 and 8.61 while rows sit at a median 30.19, which is why M83.1 is void.","multipliers":[1.0,1.5,2.0,3.0],"placement_unit":"data_extent","placement_unit_rationale":"N83.8. The median distance from a fit row to its own class centroid. The requirement the unit must meet is only that it not depend on the learnable radii, so that the v12 cancellation cannot reappear; a statistic of frozen fit data satisfies that as completely as N83.6's tangent median did, while landing the ladder where a negative is actually negative. Registered here rather than hardcoded so the choice that voided M83.1 is a recorded decision.","seed_offset":83300,"train_families":["axis_tangent","normal"]},"program":"v13","registration_notes":["N83.1 - a boundary that moves is satisfiable by noise. The shuffled-owner null shares the geometry, probe count, distances, optimiser, step budget and split, and movement alone is necessary but not sufficient: the trained boundary must also improve real out-of-set recall at matched coverage over its own initialisation. The v12-form arm is retained as the instrument's negative end. If it does not fail the degeneracy test while the absolute arm passes, M83 is void.","N83.2 - the out-of-set rows are domain-stratified to the corpus and per-domain recall is reported beside every aggregate. Sketch is 0 of 13865 rows because the corpus itself holds only 158 sketch rows; no sketch claim is available.","N83.3 - known-class coverage is matched at 90 percent before any recall figure is read, and the known-class novel-image control must be accepted at that operating point.","N83.4 - Phase A is a closed-form SVD fit and is exactly converged, which is stronger than the registered iterative fit. Recorded so the deviation is visible.","N83.5 - the degeneracy contract is read on the mean probe score, not on the hinged objective. A probe already outside its boundary contributes zero gradient, so a saturated healthy objective and a scale-blind one are indistinguishable under the hinge. The hinged gradient and the active fraction are reported as context, never as verdict.","N83.6 - probes are placed at multiples of one global radius shared by every class rather than at multiples of the inter-centroid distance. Boundaries sit at roughly four percent of the centroid distance, so a ladder measured in that unit lands entirely outside the band where supervision does work. The unit is a single scalar over frozen geometry and cannot carry any individual class's extent, which is the property that blocks the v12 cancellation.","N83.7 - the known-class evaluation rows are selected by domain quota rather than by position, which is a deliberate deviation from the M80 and M81 partition. The corpus is class-major and every class stores its 350 quickdraw rows first, so taking rows 512 to 576 of each class yields a held-out set containing zero quickdraw against an out-of-set that is 61 percent quickdraw. Under that split the rejection comparison measures domain, not novelty, and N83.2's guarantee was void on the known side even though it held on the unseen side. The quota split matches the two profiles to a deviation of 0.0 and, as a side effect, makes the fit set domain-representative as well: quickdraw falls from 68.4 percent of the fit rows to 60.7 percent against a corpus share of 60.8 percent. This was found from a smoke run and changed before any evidence was sealed; it is a defect in the measurement setup, not a result that was disliked.","N83.7a - the same positional split underlies M80 and M81, whose held-out accuracy figures were therefore read on evaluation rows containing no quickdraw at all while their dictionaries were fitted on rows that were 68 percent quickdraw. Those milestones' evidence is sealed and is not retouched. The figures stand as measured; what they measure is narrower than their prose implies, and any later claim resting on them must say so.","N83.8 - M83.1's probe ladder lay entirely inside the known cloud and its evidence is void, not negative. N83.6's unit is the median fitted tangent scale, a per-direction spread inside a rank-51 subspace of 384 dimensions, while the distance from a row to its own centroid is dominated by the 333 residual dimensions that subspace does not describe. On this corpus the unit is 2.87 and the multipliers 1 to 3 placed every probe between 2.87 and 8.61, against a median row distance of 30.19 and a tenth percentile of 24.36. No boundary can accept rows at 24 to 30 and reject points at 5 to 8 along the same rays, so the supervision was asked for something incoherent rather than merely hard. The signature in M83.1's sealed evidence is that all four arms, including the untrained one, rejected exactly zero held-out probes. The placement unit becomes the median distance from a fit row to its own centroid, and the probe ladder is now checked before anything else in the gate: a run whose probes do not reach past the known cloud returns probe_ladder_interior and reports no recall figure at all. The diagnostic is a comparison of raw distances involving no radius, no arm and no outcome, so applying it cannot be a rescue of a result that was disliked."],"schema_version":1,"sealed":true,"seeds":[11,23,37],"training":{"batch_size":512,"epochs":40,"learning_rate":0.02,"margin":0.25,"optimizer":"adam","optimizer_caution":"Adam divides by the running root mean square of the gradient, so a dead term still produces movement from pure numerical noise. Displacement is therefore never read as evidence on its own; see N83.1.","probe_weight":1.0}}
