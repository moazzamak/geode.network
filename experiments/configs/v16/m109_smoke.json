    "source": "GEODE_CACHE_DIR/domainnet/repository/data (parquet)",
    "image_size": 32,
    "train_rows_per_class": 8,
    "test_rows_per_class": 2,
    "subsample_seed": 107,
    "shuffle_seed": 11,
    "pixel_identity_rows": 16,
    "expected_subsample_sha256": null
  },
  "device": {
    "encode": "cuda",
    "whiten": "cpu",
    "training": "cuda",
    "ridge": "cpu"
  },
  "parity_guard": {
    "bound_relative": 1e-04,
    "models": ["small"],
    "resolution": 28,
    "batch": 2,
    "feature": "CLS token concatenated with the mean of the patch tokens"
  },
  "dense": {
    "model": "dinov2-small",
    "resolutions": [28],
